# Riot Games API
# Get your key at https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-your-key-here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/lolstats?schema=public

# Redis connection
REDIS_URL=redis://localhost:6379

# Optional - defaults to true. Set to false to bypass caching during development
CACHE_ENABLED=true

# Optional - rate limiting per IP (req per minute)
RATE_LIMIT_PER_MINUTE=60
