{
  "name": "lol-stats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed:analytics": "node --input-type=module -e \"import('node:http').then(({request})=>{const b=JSON.stringify({region:'BR1',tier:'challenger',playerLimit:10,matchesPerPlayer:10});const r=request({hostname:'localhost',port:3000,path:'/api/admin/champions/ingest',method:'POST',headers:{'Content-Type':'application/json','Content-Length':Buffer.byteLength(b)}},res=>{let d='';res.on('data',c=>d+=c);res.on('end',()=>console.log(JSON.parse(d)))});r.write(b);r.end()})\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "ioredis": "^5.4.1",
    "next": "14.2.15",
    "p-limit": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^4.1.5"
  }
}
